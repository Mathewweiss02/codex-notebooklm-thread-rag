{
  "schemaVersion": 1,
  "policy": "remote-notebooklm-secrets-redacted-v1",
  "patterns": [
    { "label": "pem-private-key", "pattern": "-----BEGIN (?:RSA |EC |OPENSSH |DSA )?PRIVATE KEY-----[\\s\\S]*?-----END (?:RSA |EC |OPENSSH |DSA )?PRIVATE KEY-----", "flags": "g" },
    { "label": "aws-access-key", "pattern": "\\b(?:AKIA|ASIA)[0-9A-Z]{16}\\b", "flags": "g" },
    { "label": "google-api-key", "pattern": "\\bAIza[0-9A-Za-z_-]{30,}\\b", "flags": "g" },
    { "label": "openai-key", "pattern": "\\bsk-(?:proj-|svcacct-)?[A-Za-z0-9_-]{12,}\\b", "flags": "g" },
    { "label": "github-token", "pattern": "\\b(?:ghp|gho|ghu|ghs|ghr)_[A-Za-z0-9]{20,}\\b|\\bgithub_pat_[A-Za-z0-9_]{20,}\\b", "flags": "g" },
    { "label": "slack-token", "pattern": "\\bxox[baprs]-[A-Za-z0-9-]{12,}\\b", "flags": "g" },
    { "label": "stripe-secret", "pattern": "\\b(?:sk|rk)_(?:live|test)_[A-Za-z0-9]{12,}\\b", "flags": "g" },
    { "label": "jwt", "pattern": "\\beyJ[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}\\b", "flags": "g" },
    { "label": "authorization", "pattern": "\\b(?:Authorization\\s*:\\s*)?(?:Bearer|Basic)\\s+[A-Za-z0-9._~+/=-]{12,}", "flags": "gi" },
    { "label": "cookie-header", "pattern": "\\b(?:Cookie|Set-Cookie)\\s*:\\s*[^\\r\\n]{12,}", "flags": "gi" },
    { "label": "url-credential", "pattern": "\\bhttps?:\\/\\/([^\\s:/?#]+):([^\\s@/?#]+)@", "flags": "gi" },
    { "label": "user-home-path", "pattern": "[A-Za-z]:[\\\\/]Users[\\\\/][^\\\\/\\s\"'<>\\]\\)]+(?:[\\\\/])?", "flags": "gi" },
    { "label": "unix-home-path", "pattern": "\\/(?:Users?|home)\\/[^/\\s\"'<>\\]\\)]+(?:\\/)?", "flags": "gi" },
    { "label": "query-secret", "pattern": "([?&](?:access_token|auth_token|api_key|apikey|client_secret|refresh_token|signature|sig)=)[^&\\s#]+", "flags": "gi" },
    { "label": "named-secret", "pattern": "\\b(password|passwd|pwd|secret|client[_ -]?secret|private[_ -]?key|refresh[_ -]?token|access[_ -]?token|auth[_ -]?token|api[_ -]?key|access[_ -]?key|session[_ -]?token)\\s*[:=]\\s*(?:[\"'][^\"'\\r\\n]{6,}[\"']|[^\\s,;\\r\\n]{6,})", "flags": "gi" },
    { "label": "data-url", "pattern": "data:[A-Za-z0-9.+/-]+;base64,[A-Za-z0-9+/=\\r\\n]{80,}", "flags": "g" },
    { "label": "large-base64", "pattern": "\\b[A-Za-z0-9+/]{240,}={0,2}\\b", "flags": "g" }
  ]
}
